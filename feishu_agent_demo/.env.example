# =========================
# 飞书开放平台应用配置
# =========================
# 从飞书开放平台应用详情页复制，不要把真实密钥提交到代码仓库。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# 飞书多维表格配置（采购 Demo）
# =========================
# BITABLE_APP_TOKEN：多维表格（Base）的 app token
BITABLE_APP_TOKEN=bascnxxxxxxxxxxxxxxxx

# 核心四表 table_id（必填，与 Base 中 Demands / Suppliers / Orders / Audit_Logs 对应）
TABLE_ID_DEMANDS=tblxxxxxxxxxxxxxxxx
TABLE_ID_SUPPLIERS=tblxxxxxxxxxxxxxxxx
TABLE_ID_ORDERS=tblxxxxxxxxxxxxxxxx
TABLE_ID_LOGS=tblxxxxxxxxxxxxxxxx



# =========================
# Demo 运行参数
# =========================
# 轮询间隔，单位为秒；本题要求默认 10 秒。
POLL_INTERVAL_SECONDS=10

# 为 true（默认）时，主程序每轮对「待辩论」自动执行 run_audit_debate（每轮最多 1 条），无需再发 IM「触发审批」
# 设为 false 则仅能通过私聊「触发审批 …」启动辩论与卡片
AUTO_RUN_AUDIT_DEBATE=true
# 为 true：审批链为 待主管审批(终审) → 待采购确认(对接供方) → 待运输审批 → 建单（Demands.status 需含对应选项；Personnel 配 Approver/采购/物流）
# 为 false：单状态「待审批」一张卡，点同意即下单
MULTI_STAGE_APPROVAL=false

# 需求表字段（与 Bitable 列名一致；触发审批支持 DEM-xxx 时按 demand_code 查找）
DEMAND_FIELD_DEMAND_CODE=demand_code
# IM 新建需求时自动生成 demand_code 的前缀（日期+时间+随机尾数保证唯一）
DEMAND_CODE_PREFIX=DEM

# 任务表字段配置（默认值与数据表设计一致，无需修改）
TASK_FIELD_TASK_ID=task_id
TASK_FIELD_TITLE=task_title
TASK_FIELD_REQUIREMENT=task_requirement
TASK_FIELD_CONTENT_TYPE=content_type
TASK_FIELD_PRIORITY=priority
TASK_FIELD_STATUS=task_status
TASK_FIELD_CREATOR_AGENT=creator_agent
TASK_FIELD_AUDITOR_AGENT=auditor_agent
TASK_FIELD_PUBLISHER_AGENT=publisher_agent
TASK_FIELD_CREATED_AT=created_at
TASK_FIELD_DEADLINE=deadline
TASK_FIELD_FINAL_SCORE=final_score

# 内容表字段配置（默认值与数据表设计一致，无需修改）
CONTENT_FIELD_CONTENT_ID=content_id
CONTENT_FIELD_TASK_ID=task_id
CONTENT_FIELD_WRITER_AGENT=writer_agent
CONTENT_FIELD_CONTENT_TEXT=content_text
CONTENT_FIELD_AUDIT_RESULT=audit_result
CONTENT_FIELD_AUDIT_COMMENT=audit_comment
CONTENT_FIELD_AUDIT_TIME=audit_time
CONTENT_FIELD_PUBLISH_URL=publish_url
CONTENT_FIELD_PUBLISH_TIME=publish_time
CONTENT_FIELD_VIEW_COUNT=view_count
CONTENT_FIELD_QUALITY_SCORE=quality_score

# 业务状态配置（默认值与数据表设计一致，无需修改）
TASK_STATUS_PENDING_ASSIGN=待分配
TASK_STATUS_PENDING_WRITE=待创作
TASK_STATUS_PENDING_AUDIT=待审核
TASK_STATUS_PENDING_PUBLISH=待发布
TASK_STATUS_COMPLETED=已完成
TASK_STATUS_REJECTED=已驳回

# 审核结果配置（默认值与数据表设计一致，无需修改）
AUDIT_RESULT_PASS=通过
AUDIT_RESULT_REJECT=驳回
AUDIT_RESULT_MODIFY_PASS=修改后通过

# =========================
# 大模型调用配置
# =========================
# true：使用本地 Mock，适合演示流程
# false：调用真实大模型 HTTP API
USE_MOCK_LLM=true

# 下面三个变量在接入真实大模型时再填写
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
# 大模型 HTTP：连接超时（秒）、读超时（秒）；辩论等长输出建议读超时 120+
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=120
# 接入支持 JSON Mode 的网关（如 OpenAI 兼容 / 部分火山 Ark）时设为 true，辩论请求会带 response_format=json_object
LLM_JSON_MODE=false

# =========================
# 扩展业务表（可选）
# =========================
# 若已创建以下表，请填入对应 table_id（只填 tbl...，不要粘贴 &view=vew...）；未创建可留空。
TABLE_ID_PERSONNEL=
# Debate_History / 决策辩论记录
TABLE_ID_DEBATE_HISTORY=
# Business_Rules / 业务映射规则（配置 table_id 后 Planner 会读取 is_active=true 的行）
# ① 字段补全：condition_key=always|when_text_contains；target_action=requester=张三;department=生产
# ② 预算预审：condition_key=max_budget_cny 且 condition_value=金额；或 category_is + condition_value=品类名，上限写在 target_action：max_budget_cny=50000
TABLE_ID_BUSINESS_RULES=
# Interaction_Memory / 会话记忆（配置后每次 IM 成功建单写入一条：message_id、open_id、related_record_id、summary）
TABLE_ID_INTERACTION_MEMORY=

# script/inject_personnel_mock.py：所有 Mock 负责人行共用的飞书 open_id（机器人私聊日志可复制）
MOCK_PERSONNEL_FEISHU_OPEN_ID=
