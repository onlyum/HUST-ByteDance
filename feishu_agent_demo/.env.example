# =========================
# 飞书开放平台应用配置
# =========================
# 从飞书开放平台应用详情页复制，不要把真实密钥提交到代码仓库。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# 飞书多维表格配置
# =========================
# BITABLE_APP_TOKEN：多维表格（Base）的 app token
# TASK_TABLE_ID：选题任务表的 table_id
# CONTENT_TABLE_ID：内容数据表的 table_id
BITABLE_APP_TOKEN=bascnxxxxxxxxxxxxxxxx
TASK_TABLE_ID=tblxxxxxxxxxxxxxxxx
CONTENT_TABLE_ID=tblxxxxxxxxxxxxxxxx



# =========================
# Demo 运行参数
# =========================
# 轮询间隔，单位为秒；本题要求默认 10 秒。
POLL_INTERVAL_SECONDS=10

# 任务表字段配置（默认值与数据表设计一致，无需修改）
TASK_FIELD_TASK_ID=task_id
TASK_FIELD_TITLE=task_title
TASK_FIELD_REQUIREMENT=task_requirement
TASK_FIELD_CONTENT_TYPE=content_type
TASK_FIELD_PRIORITY=priority
TASK_FIELD_STATUS=task_status
TASK_FIELD_CREATOR_AGENT=creator_agent
TASK_FIELD_AUDITOR_AGENT=auditor_agent
TASK_FIELD_PUBLISHER_AGENT=publisher_agent
TASK_FIELD_CREATED_AT=created_at
TASK_FIELD_DEADLINE=deadline
TASK_FIELD_FINAL_SCORE=final_score

# 内容表字段配置（默认值与数据表设计一致，无需修改）
CONTENT_FIELD_CONTENT_ID=content_id
CONTENT_FIELD_TASK_ID=task_id
CONTENT_FIELD_WRITER_AGENT=writer_agent
CONTENT_FIELD_CONTENT_TEXT=content_text
CONTENT_FIELD_AUDIT_RESULT=audit_result
CONTENT_FIELD_AUDIT_COMMENT=audit_comment
CONTENT_FIELD_AUDIT_TIME=audit_time
CONTENT_FIELD_PUBLISH_URL=publish_url
CONTENT_FIELD_PUBLISH_TIME=publish_time
CONTENT_FIELD_VIEW_COUNT=view_count
CONTENT_FIELD_QUALITY_SCORE=quality_score

# 业务状态配置（默认值与数据表设计一致，无需修改）
TASK_STATUS_PENDING_ASSIGN=待分配
TASK_STATUS_PENDING_WRITE=待创作
TASK_STATUS_PENDING_AUDIT=待审核
TASK_STATUS_PENDING_PUBLISH=待发布
TASK_STATUS_COMPLETED=已完成
TASK_STATUS_REJECTED=已驳回

# 审核结果配置（默认值与数据表设计一致，无需修改）
AUDIT_RESULT_PASS=通过
AUDIT_RESULT_REJECT=驳回
AUDIT_RESULT_MODIFY_PASS=修改后通过

# =========================
# 大模型调用配置
# =========================
# true：使用本地 Mock，适合演示流程
# false：调用真实大模型 HTTP API
USE_MOCK_LLM=true

# 下面三个变量在接入真实大模型时再填写
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=30
