# =========================
# 飞书开放平台应用配置
# =========================
# 从飞书开放平台应用详情页复制，不要把真实密钥提交到代码仓库。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# 飞书多维表格配置（采购 Demo）
# =========================
# BITABLE_APP_TOKEN：多维表格（Base）的 app token
BITABLE_APP_TOKEN=bascnxxxxxxxxxxxxxxxx

# 核心四表 table_id（必填，与 Base 中 Demands / Suppliers / Orders / Audit_Logs 对应）
TABLE_ID_DEMANDS=tblxxxxxxxxxxxxxxxx
TABLE_ID_SUPPLIERS=tblxxxxxxxxxxxxxxxx
TABLE_ID_ORDERS=tblxxxxxxxxxxxxxxxx
TABLE_ID_LOGS=tblxxxxxxxxxxxxxxxx

# =========================
# Demo 运行参数
# =========================
# 编排轮询间隔（秒）
POLL_INTERVAL_SECONDS=10

# true：每轮自动对「待辩论」执行 run_audit_debate（每轮最多 1 条），一般无需再发 IM「触发审批」
# false：仅能通过私聊「触发审批 + 需求编号」启动辩论与卡片
AUTO_RUN_AUDIT_DEBATE=true

# true：待主管审批 → 待采购确认 → 待运输审批 → 卡片通过后建 Orders（需 Demands.status 含对应选项，并配置 Personnel）
# false：单状态「待审批」一张卡，通过后建单
MULTI_STAGE_APPROVAL=false

# 需求编号列名与生成前缀（与 Bitable 一致；IM 触发审批支持 DEM-xxx）
DEMAND_FIELD_DEMAND_CODE=demand_code
DEMAND_CODE_PREFIX=DEM

# =========================
# 可选：表列名覆盖（与 script/sqlinit.py 一致时可不填）
# =========================
# DEMAND_FIELD_STATUS=status
# DEMAND_FIELD_SOURCE_INSTRUCTION=source_instruction
# DEMAND_FIELD_RECOMMENDED_SUPPLIERS=recommended_suppliers
# DEMAND_FIELD_BUDGET_AMOUNT=budget_amount
# DEMAND_FIELD_CATEGORY=category
# DEMAND_FIELD_ITEM_NAME=item_name
# DEMAND_FIELD_SPEC=spec
# DEMAND_FIELD_QUANTITY=quantity
# DEMAND_FIELD_UOM=uom
# DEMAND_FIELD_DEPARTMENT=department
# DEMAND_FIELD_REQUESTER=requester
# DEMAND_FIELD_CURRENCY=currency
# DEMAND_FIELD_NEED_BY_DATE=need_by_date
# DEMAND_FIELD_PRIORITY=priority
# ORDER_FIELD_LOGISTICS_STATUS=logistics_status
# ORDER_FIELD_EXPECTED_DELIVERY_DATE=expected_delivery_date
# ORDER_FIELD_DEMAND=demand
# ORDER_FIELD_SUPPLIER=supplier

# =========================
# 大模型调用配置
# =========================
# true：本地 Mock，适合打通流程
# false：调用真实大模型 HTTP API
USE_MOCK_LLM=true

LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
# 辩论等长输出建议读超时 120+
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=120
# OpenAI 兼容 / 部分火山 Ark 等支持 JSON Mode 时设为 true
LLM_JSON_MODE=false

# =========================
# 扩展业务表（可选）
# =========================
# 只填 tbl...，不要带 &view=...
TABLE_ID_PERSONNEL=
TABLE_ID_DEBATE_HISTORY=
# Business_Rules：Planner 读取 is_active=true；字段补全 / 预算预审等见方案设计说明
TABLE_ID_BUSINESS_RULES=
# IM 建单后写入会话摘要（message_id、open_id 等）
TABLE_ID_INTERACTION_MEMORY=

# inject_personnel_mock.py：Mock 负责人行共用的飞书 open_id（机器人单聊事件里可复制）
MOCK_PERSONNEL_FEISHU_OPEN_ID=
