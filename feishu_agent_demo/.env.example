# =========================
# 飞书开放平台应用配置
# =========================
# 从飞书开放平台应用详情页复制，不要把真实密钥提交到代码仓库。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# 飞书多维表格配置
# =========================
# BITABLE_APP_TOKEN：多维表格（Base）的 app token
# TABLE_ID：具体数据表的 table_id
BITABLE_APP_TOKEN=bascnxxxxxxxxxxxxxxxx
TABLE_ID=tblxxxxxxxxxxxxxxxx

# 基础凭证（从开发者后台-凭证与基础信息获取）
FEISHU_APP_ID="你的_App_ID"
FEISHU_APP_SECRET="你的_App_Secret"

# 业务表配置（从你刚刚发的 URL 提取）
BITABLE_APP_TOKEN="IMWGbbzIlay7AXsiEooch4bnnY9"
TABLE_ID="tblZyofry36euas5"

# =========================
# Demo 运行参数
# =========================
# 轮询间隔，单位为秒；本题要求默认 10 秒。
POLL_INTERVAL_SECONDS=10

# 表格字段名配置
TITLE_FIELD_NAME=任务标题
STATUS_FIELD_NAME=状态
OUTPUT_FIELD_NAME=输出结果

# 状态值配置
PENDING_STATUS=待处理
PROCESSING_STATUS=处理中
REVIEW_STATUS=待审核
FAILED_STATUS=处理失败

# =========================
# 大模型调用配置
# =========================
# true：使用本地 Mock，适合演示流程
# false：调用真实大模型 HTTP API
USE_MOCK_LLM=true

# 下面三个变量在接入真实大模型时再填写
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=30
